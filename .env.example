# Postgres (docker compose maps it to 5433)
DATABASE_URL=postgres://platforma:platforma@localhost:5433/platforma

# Public URL of the app, used in WhatsApp links and push notifications
APP_URL=http://localhost:3000

# Faza 1 runs a single business; this is its slug.
DEFAULT_BIZNES_SLUG=dekor-for-events

# Where uploaded photos are stored (local disk in Faza 1)
STORAGE_DIR=./storage

# Protects /api/cron/* — send as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=change-me

# WhatsApp Business Cloud API (leave empty to only log notifications)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANG=sq

# Web push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Seeded owner login for local development
SEED_ADMIN_EMAIL=pronari@example.com
SEED_ADMIN_PASSWORD=

# Vercel Blob (photos in production). Set automatically when a Blob store is
# connected to the Vercel project. Leave empty locally to keep photos on disk.
BLOB_READ_WRITE_TOKEN=
# private (default) or public — must match the Blob store's access setting
BLOB_ACCESS=private
